# Copy to .env.local and fill in. .env.local is gitignored.

# PostgreSQL connection string (Aiven: Console → Service → Connection information → Service URI)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Optional: path to the provider's CA certificate. When set, the server certificate is fully verified.
# DATABASE_CA_CERT_PATH=./certs/aiven-ca.pem

# Optional: max connections per server process (default 5). Keep the total under your plan's limit.
# DATABASE_POOL_MAX=5

# Emails (comma-separated) that can open /admin to create and edit journeys.
# ADMIN_EMAILS=you@example.com

# GITHUB_CLIENT_ID=  (from OAuth app)
# GITHUB_CLIENT_SECRET=  (from OAuth app)
