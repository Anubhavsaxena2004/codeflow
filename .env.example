# Copy to .env.local and fill in. .env.local is gitignored.

# PostgreSQL connection string. Supabase: Connect → Session pooler (IPv4; the direct
# db.<ref>.supabase.co host is IPv6-only). URL-encode special characters in the password (! → %21).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Aiven: Console → Service → Connection information → Service URI
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Optional: path to the provider's CA certificate. When set, the server certificate is fully verified.
# DATABASE_CA_CERT_PATH=./certs/aiven-ca.pem

# Optional: max connections per server process (default 5). Keep the total under your plan's limit.
# DATABASE_POOL_MAX=5

# Emails (comma-separated) that can open /admin and /mentor. Leave unset: the only admin is then the
# owner email in lib/server/auth.ts. Create that account with: npm run admin:create -- <email> <password>
# ADMIN_EMAILS=you@example.com

# Required for GitHub pushes: encrypts every learner's GitHub token at rest. 16+ random characters.
# TOKEN_ENCRYPTION_KEY=

# Optional: one GitHub OAuth app serves every learner ("Connect GitHub" button).
# Without it, learners connect by pasting a personal access token.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
